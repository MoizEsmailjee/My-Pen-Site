rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "ananyapoudel641@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function uidUnchanged() {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidOrder(data) {
      return hasRequiredFields([
          'userId',
          'orderNumber',
          'customerName',
          'phone',
          'city',
          'address',
          'paymentMethod',
          'items',
          'subtotal',
          'deliveryFee',
          'total',
          'timestamp',
          'createdAt'
        ]) &&
        hasOnlyAllowedFields([
          'userId',
          'userEmail',
          'orderNumber',
          'orderStatus',
          'trackingCode',
          'estimatedDelivery',
          'customerName',
          'phone',
          'city',
          'address',
          'paymentMethod',
          'items',
          'subtotal',
          'deliveryFee',
          'total',
          'timestamp',
          'createdAt'
        ]) &&
        data.userId is string &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 160)) &&
        (!('orderStatus' in data) || (data.orderStatus in ['Processing', 'Out for Courier', 'Delivered'])) &&
        (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 64)) &&
        (!('estimatedDelivery' in data) || (data.estimatedDelivery is string && data.estimatedDelivery.size() <= 160)) &&
        data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 4 && data.phone.size() <= 40 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 120 &&
        data.address is string && data.address.size() >= 2 && data.address.size() <= 300 &&
        data.paymentMethod in ['mpesa', 'cod'] &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.deliveryFee is number && data.deliveryFee >= 0 &&
        data.total is number && data.total >= 0 &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 80 &&
        data.createdAt is number && data.createdAt >= 0;
    }

    function isValidProduct(data) {
      return hasRequiredFields([
          'id',
          'name',
          'category',
          'priceKes',
          'image',
          'availability',
          'shortSummary'
        ]) &&
        data.id is string && data.id.size() >= 2 && data.id.size() <= 100 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.category in ['Fountain Pens', 'Bottled Inks', 'Converters & Refills'] &&
        data.priceKes is number && data.priceKes >= 0 && data.priceKes <= 1000000 &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 300 &&
        data.availability is string && data.availability.size() >= 1 && data.availability.size() <= 120 &&
        data.shortSummary is string && data.shortSummary.size() <= 1000;
    }

    function isValidStoreSettings(data) {
      return hasRequiredFields([
          'inkMixingSetBundleKes',
          'freeDeliveryThresholdKes'
        ]) &&
        data.inkMixingSetBundleKes is number && data.inkMixingSetBundleKes >= 0 &&
        data.freeDeliveryThresholdKes is number && data.freeDeliveryThresholdKes >= 0;
    }

    match /orders/{orderId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && uidUnchanged() && data.userId == request.auth.uid && isValidOrder(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidOrder(request.resource.data) &&
        areImmutableFieldsUnchanged(['userId', 'orderNumber', 'createdAt']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /store_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidStoreSettings(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{adminUid} {
      allow read: if isAuthenticated() && request.auth.uid == adminUid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
