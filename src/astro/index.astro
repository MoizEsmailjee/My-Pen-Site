---
/**
 * PENS R US — Astro Islands Architecture Blueprint (src/astro/index.astro)
 *
 * How Astro enhances PENS R US:
 * 1. Zero-JS Editorial Shell: The Hero showcase, 4-pillar Provenance Strip,
 *    Japanese Craftsmanship narrative ("More Than Just Writing"), and Footer
 *    compile to pure static HTML + CSS at build time for instant First Contentful Paint.
 * 2. Selective Island Hydration (@astrojs/react):
 *    - `client:load`    -> Top Navigation Bag Counter & Slide-Over Kenya Checkout Drawer
 *    - `client:visible` -> ChromaticInkRibbonIsland (24-color Iroshizuku spectrum & 3x optical zoom)
 *    - `client:visible` -> WritingSetBuilderIsland (Pen + CON-40 Converter + Ink configurator)
 *    - `client:idle`    -> Interactive Nib & Ink Washi Paper Studio
 */

import { FEATURED_PRODUCTS, INK_STUDIO_SHADES } from '../data/products';
import { ChromaticInkRibbonIsland } from '../islands/ChromaticInkRibbonIsland';
import { WritingSetBuilderIsland } from '../islands/WritingSetBuilderIsland';
---

<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PENS R US — Japanese Fountain Pens, Pilot Iroshizuku & Waterman Inks in Kenya</title>
  </head>
  <body class="bg-[#FAF8F5] text-[#171614] antialiased">
    <!-- Static Zero-JS Editorial Hero & Provenance Strip -->
    <main>
      <!-- Hydrated on scroll visibility: 24-Color Iroshizuku Spectrum & Dual Bottle/Swatch Stage -->
      <ChromaticInkRibbonIsland client:visible />

      <!-- Hydrated on scroll visibility: 3-Step Pen + CON-40 Converter + 50ml Ink Set Builder -->
      <WritingSetBuilderIsland client:visible />
    </main>
  </body>
</html>
